BOT_TOKEN=
BOT_USERNAME=
LOGIN=
PASSWORD=
STORAGE_PASSWORD=
STAROSTA_PASS=
ADMIN_DASHBOARD_PASS=
OPENROUTER_API_KEY=
OPENROUTER_MODELS_CACHE_TTL=3600
# Shared across bot and Mini App for each API key. Free requests: <=20/minute.
AI_MAX_CONCURRENCY=4
AI_FREE_INTERVAL_MS=3100
# Telegram only; supports http:// and socks5:// with optional credentials.
PROXY_URL=
# Public origin without /webapp. Use a domain you control for a permanent URL.
WEBAPP_URL=https://app.example.ru
MINIAPP_DOMAIN=app.example.ru
MINIAPP_PORT=8080
ADMIN_PORT=8081
# Set to https only after DNS points to this server and ports 80/443 are open.
COMPOSE_PROFILES=
